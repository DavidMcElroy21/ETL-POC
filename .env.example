# Copy to .env to override the defaults in docker-compose.yml.
#
# These are local POC credentials for containers on a private compose network.
# They are not secrets, which is why the defaults are inline in the compose file
# and this repository has no secret-management story. Do not reuse this pattern
# for anything with real data in it.

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=etl
POSTGRES_PASSWORD=etl_local_password
POSTGRES_DB=retail
# Host port for connecting a SQL client. Change if 5432 is already in use.
POSTGRES_PORT=5432

# --- SFTP ------------------------------------------------------------------
SFTP_USER=etl
SFTP_PASSWORD=etl_local_password
# Host port for connecting an SFTP client to inspect the served files. 2222 is
# a common default for other local SFTP containers, so this avoids it.
SFTP_PORT_HOST=2223

# --- Dagster ---------------------------------------------------------------
# Host port for the Dagster UI.
DAGSTER_PORT=3000

# --- Alternative ingestion targets -----------------------------------------
# Infrastructure for options 4 and 5 in docs/local-ingestion-options.md. These
# services run and are seeded; the code that reads from them is left as an
# exercise for an offline model.

# MinIO (option 4)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=etl-poc
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# CDC source database (option 5)
CDC_SOURCE_USER=cdc
CDC_SOURCE_PASSWORD=cdc_local_password
CDC_SOURCE_DB=shop
# Host port. 5433 is a common default for other local Postgres containers.
CDC_SOURCE_PORT_HOST=5434
