# ---------------------------------------------------------------------------
# Agent / assistant instruction files.
#
# This repository is published for model testing. Instruction files of any kind
# would leak into the test corpus and bias evaluation results, so they are
# excluded here and enforced by scripts/check_no_agent_files.py in CI.
# ---------------------------------------------------------------------------
